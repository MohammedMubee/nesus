# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Format: mongodb://<HOST>:<PORT>/<DATABASE> or mongodb+srv://<USER>:<PASSWORD>@<HOST>/<DATABASE>
MONGODB_URI="mongodb://127.0.0.1:27017/nexus_crm"

# JWT Auth
JWT_SECRET="nexus_crm_enterprise_jwt_super_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (Frontend Vite dev server)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"
